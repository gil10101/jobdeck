# Dependencies
node_modules/
bun.lock

# Compiled documents
*.pdf
*.aux
*.log
*.out
*.synctex.gz
*.fls
*.fdb_latexmk

# Per-user Claude Code context. Anything a contributor writes here describes
# their own machine and profile, not the product.
# (cv/main_example.tex IS tracked — it's a placeholder template, no personal data.)
/CLAUDE.md

# Debug artifacts
app/scripts/probe-dump.json

# Personal photos and signatures
*.jpg
*.jpeg
*.png
!cover_letters/OpenFonts/fonts/**

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Memory files (Claude Code user-specific)
.claude/projects/

# Skills lock (auto-generated)
skills-lock.json

# Tailored résumés and cover letters written next to the templates — personal
# output, never shared. The _example files are the tracked placeholders.
cv/main_*.tex
!cv/main_example.tex
cv/*.txt
cover_letters/cover_*.tex
cover_letters/Cover_*.tex
!cover_letters/cover_example.tex

# Personal job search tracking
job_search_tracker.csv
applications.xlsx

# Raw personal input folder (resume drop) — never commit
myinfo/

# Upskill reports (personal output)
upskill/*.md

# Agent skills: track the source, ignore only deps and logs.
# (A blanket `.agents/` ignore silently drops the job-search CLI skills from the repo.)
.agents/**/node_modules/
.agents/**/*.log
.agents/usage/

# Portal credentials + cached sessions (personal secrets — never commit)
.agents/skills/*/credentials.json
.agents/skills/*/.session.json
.agents/skills/*/.feed-cache.json
.agents/skills/*/.feed-cache.lock
.agents/skills/*/.throttle

# Desktop app build output
app/out/
app/dist/

# Secrets in dotfiles — the app injects provider keys into agent subprocesses,
# so an .env is the likeliest way a key reaches a commit.
.env
.env.*
!.env.example

# Workspace artifacts. A user may point the app at this checkout as their
# workspace; these are the files it would then write here. They are personal
# data and must never be committed.
/profile.json
/tracker.json
/companies.json
# The app writes these alongside the originals and they hold the same data.
/profile.json.bak
/tracker.backup.json
/board-creds.json
/applications/
/runs/
/scout/
/master/
/templates/
/onboarding/
/uploads/
/intake-images/
/exports/
/assistant/
/tmp/

# Internal planning artifacts (machine paths, not product)
.superpowers/

# Development docs (plans, reviews) are working material, never published
/docs/
